PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/caderno-financeiro-dev

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula (opcional)
# CORS_ORIGIN=http://localhost:5173
# Tentativas de login/cadastro por IP a cada 15 minutos (opcional)
# AUTH_RATE_LIMIT=20

# Endereço público do sistema, usado no link de recuperação de senha
# APP_URL=http://localhost:3000
# E-mail (opcional). Sem SMTP, o link de recuperação aparece no console do servidor.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha
# MAIL_FROM="Caderno Financeiro <no-reply@exemplo.com>"
